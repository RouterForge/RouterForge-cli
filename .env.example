# Environment variables for big-pickle (production)
# Copy to .env and adjust values.

# Application
PORT=8080
ENV=production
LOG_LEVEL=info

# Database (PostgreSQL)
DB_HOST=your-rds-endpoint
DB_PORT=5432
DB_USER=bigpickle
DB_PASSWORD=change-me
DB_NAME=bigpickle

# Optional: Redis, JWT, etc.
# REDIS_URL=redis://localhost:6379
# JWT_SECRET=your-jwt-secret